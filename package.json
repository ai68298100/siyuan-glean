{
  "name": "siyuan-glean",
  "version": "1.0.1",
  "type": "module",
  "description": "小驴拾遗 (Lv Glean)：把思源里剪藏/导入后吃灰的文章，变成有生命周期、能被消化的阅读库——属性规范、状态分拣、AI 富化、每日重浮，数据全本地",
  "repository": "https://github.com/ai68298100/siyuan-glean",
  "homepage": "https://github.com/ai68298100/siyuan-glean",
  "author": "ai68298100",
  "license": "MIT",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development VITE_SOURCEMAP=inline vite build --watch",
    "build": "run-s clean build:app",
    "build:app": "cross-env NODE_ENV=production vite build",
    "check": "run-s check:types check:svelte",
    "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "clean": "node scripts/clean.js",
    "make-link": "node scripts/make_dev_link.js",
    "make-install": "pnpm run build && node --no-warnings ./scripts/make_install.js",
    "update-version": "node --no-warnings ./scripts/update_version.js",
    "test": "node --test tests/schema.test.ts tests/migrate.test.ts tests/stats.test.ts tests/i18n.test.ts tests/architecture.test.ts tests/enrich.test.ts tests/resurface.test.ts tests/settings.test.ts tests/importers.test.ts tests/flashcard.test.ts tests/checkin.test.ts",
    "check:release": "node scripts/check-release.mjs",
    "spike": "node scripts/spike/glean-spike.mjs",
    "icon": "node scripts/gen-icon.mjs a"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/livereload": "^0.9.5",
    "@types/node": "^26.4.0",
    "cross-env": "^10.1.0",
    "fast-glob": "^3.3.3",
    "livereload": "^0.9.3",
    "npm-run-all": "^4.1.5",
    "sass-embedded": "^1.105.0",
    "siyuan": "1.2.7",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-zip-pack": "^1.2.4"
  }
}
